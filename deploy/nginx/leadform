# /etc/nginx/sites-enabled/leadform on the website EC2 (t4g.medium). Live copy taken 2026-11-19,
# plus the 1.2 click rate limit (needs conf.d/client-ip.conf). TLS is terminated by CloudFront → port 80.
server {
      listen 80;
      listen [::]:80;
      server_name tandem.it.com www.tandem.it.com;

      root /var/www/leadform;
      index index.html;

      client_max_body_size 50m;
      sendfile on;

      add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

      # 1.6: prerendered pages first (dist/<route>/index.html), then the untouched SPA shell.
      # spa.html, never index.html: the homepage snapshot lives in index.html.
      # HTML is never cached, so a deploy shows up at once. (add_header in a location drops the
      # server-level one, hence HSTS repeated.)
      location / {
          try_files $uri $uri/index.html /spa.html;
          add_header Cache-Control "no-cache" always;
          add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
      }

      # Vite's hashed bundles never change once built: cache for a year (CloudFront + browsers).
      # Deploys copy over without deleting, so last build's files stay for tabs opened before it.
      location /assets/ {
          try_files $uri =404;
          add_header Cache-Control "public, max-age=31536000, immutable" always;
          add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
      }

      # 1.2: server-to-server attribution, no click limit. Must stay above the click regex ([^/]+ also matches "attribute").
      # Spring strips ";…" from any path segment (/api;x/leads == /api/leads), which would slip past
      # the rate-limit regexes. No page or API here uses ";", so refuse it before routing ($uri is
      # already %-decoded, so %3B is caught too). Regex locations match in file order: keep this first.
      location ~ ";" {
          return 400;
      }

      # Regexes below also match ";…" and trailing "/" variants: Spring treats /api/leads;x and
      # /api/leads/ as /api/leads, so an exact-match rule could be bypassed.
      location ~ ^/api/(referral|event-link|links)/attribute(;.*|/)?$ {
          proxy_pass http://localhost:8080;
          proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
          proxy_set_header X-Real-IP       $remote_addr;
          proxy_set_header Host $host;
      }

      # 1.2: public link clicks are keyless, so rate-limit them per real visitor IP ($client_ip, conf.d/client-ip.conf)
      location ~ ^/api/(referral/[^/;]+|event-link/[^/;]+|links/click)(;.*|/)?$ {
          limit_req zone=clicks burst=20 nodelay;
          limit_req_status 429;
          proxy_pass http://localhost:8080;
          proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
          proxy_set_header X-Real-IP       $remote_addr;
          proxy_set_header Host $host;
      }

      # 1.3: waitlist and location saves, per real visitor IP. Generous: carrier IPs are shared
      location ~ ^/api/(leads|location)(;.*|/)?$ {
          limit_req zone=forms burst=20 nodelay;
          limit_req_status 429;
          proxy_pass http://localhost:8080;
          proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
          proxy_set_header X-Real-IP       $remote_addr;
          proxy_set_header Host $host;
      }

      location /api/ {
          proxy_pass http://localhost:8080/api/;
          proxy_http_version 1.1;
          proxy_set_header Upgrade $http_upgrade;
          proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
          proxy_set_header X-Real-IP       $remote_addr;
          proxy_set_header Connection 'upgrade';
          proxy_set_header Host $host;
          proxy_cache_bypass $http_upgrade;
      }

      location /.well-known/assetlinks.json {
          alias /var/www/html/.well-known/assetlinks.json;
          default_type application/json;
          add_header Access-Control-Allow-Origin *;
      }

      location /.well-known/apple-app-site-association {
          alias /var/www/html/.well-known/apple-app-site-association;
          default_type application/json;
          add_header Access-Control-Allow-Origin *;
      }
  }
